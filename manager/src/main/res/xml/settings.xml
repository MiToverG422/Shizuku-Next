<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory
        android:key="startup"
        android:title="@string/settings_startup">

        <rikka.material.preference.MaterialSwitchPreference
            android:key="start_on_boot"
            android:summary="@string/settings_startup_broadcast_summary"
            android:title="@string/settings_startup_broadcast" />

        <rikka.material.preference.MaterialSwitchPreference
            android:key="startup_script"
            android:summary="@string/settings_startup_script_summary"
            android:title="@string/settings_startup_script" />

        <rikka.material.preference.MaterialSwitchPreference
            android:key="auto_start_on_app_open"
            android:summary="@string/settings_auto_start_on_app_open_summary"
            android:title="@string/settings_auto_start_on_app_open" />

        <rikka.material.preference.MaterialSwitchPreference
            android:key="auto_restart_in_background"
            android:summary="@string/settings_auto_restart_in_background_summary"
            android:title="@string/settings_auto_restart_in_background" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="service"
        android:title="@string/settings_service">

        <rikka.material.preference.MaterialSwitchPreference
            android:key="keep_alive_enabled"
            android:summary="@string/settings_keep_alive_summary"
            android:title="@string/settings_keep_alive" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/settings_language">

        <rikka.preference.SimpleMenuPreference
            android:defaultValue="SYSTEM"
            android:key="language"
            android:summary="%s"
            android:title="@string/settings_language" />

        <Preference
            style="?preferenceInformationStyle"
            android:key="translation_contributors"
            android:title="@string/settings_translation_contributors" />

        <Preference
            android:key="translation"
            android:title="@string/settings_translation" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="user_interface"
        android:title="@string/settings_user_interface">

        <moe.shizuku.manager.settings.IntegerSimpleMenuPreference
            android:entries="@array/night_mode"
            android:entryValues="@array/night_mode_value"
            android:key="night_mode"
            android:summary="%s"
            android:title="@string/dark_theme" />

        <rikka.material.preference.MaterialSwitchPreference
            android:key="use_system_color"
            android:title="@string/settings_use_system_color" />

    </PreferenceCategory>

</PreferenceScreen>
